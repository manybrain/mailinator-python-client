#
# Mailinator Python Client - Integration Test Settings
#
# Copy this file to `.env` and fill in values.
# Tests also accept these via environment variables.
#

# Tests configuration
DELETE_REQUESTS=false
SEND_EMAIL_ENABLED=false

# MAILINATOR
API_TOKEN=
DOMAIN=
INBOX=
SMS_DOMAIN=
SMS_PHONE_NUMBER=
MESSAGE_WITH_ATTACHMENT_ID=

# Webhooks
WEBHOOKTOKEN_PRIVATEDOMAIN=
WEBHOOKTOKEN_CUSTOMSERVICE=
WEBHOOK_INBOX=
WEBHOOK_CUSTOMSERVICE=

# Authenticators
AUTH_SECRET=
AUTH_ID=

# SMTP (only needed if SEND_EMAIL_ENABLED=true)
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
