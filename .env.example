# Mailinator API Configuration
# Documentation: https://www.mailinator.com/documentation/docs/api/index.html
# Visit https://www.mailinator.com/ to get your API token and configure domains

# Mailinator Python Client - Integration Test Settings
#
# Copy this file to `.env` and fill in values.
#

# Tests configuration
DELETE_REQUESTS=false
SEND_EMAIL_ENABLED=false

# MAILINATOR
API_TOKEN=
DOMAIN=
INBOX=
SMS_DOMAIN=
SMS_PHONE_NUMBER=
MESSAGE_WITH_ATTACHMENT_ID=

# Webhooks
WEBHOOKTOKEN_PRIVATEDOMAIN=
WEBHOOKTOKEN_CUSTOMSERVICE=
WEBHOOK_INBOX=
WEBHOOK_CUSTOMSERVICE=

# Authenticators
AUTH_SECRET=
AUTH_ID=

# SMTP (only needed if SEND_EMAIL_ENABLED=true)
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
